[Version]
Signature="$CHICAGO$"
Class=Mouse
ClassGuid={6BD07507-8F66-4E6F-8D9A-5B3E4B5B5B1A}
Provider=%MFGNAME%

[DefaultInstall]
CopyFiles=Hybrid.Files
AddReg=Hybrid.Reg

[DestinationDirs]
Hybrid.Files=10,"Cursors\Lumen_Cursors"

[Hybrid.Files]
arrow.cur
dgn2.cur
beam.cur
move.cur
vert.cur
help.cur
alternate.cur
unavailable.cur
link.cur
person.cur
horz.cur
precision.cur
handwriting.cur
pin.cur
dgn1.cur
working.ani
busy.ani

[SourceDisksFiles]
arrow.cur=1
dgn2.cur=1
beam.cur=1
move.cur=1
vert.cur=1
help.cur=1
alternate.cur=1
unavailable.cur=1
link.cur=1
person.cur=1
horz.cur=1
precision.cur=1
handwriting.cur=1
pin.cur=1
dgn1.cur=1
working.ani=1
busy.ani=1

[SourceDisksNames]
1=%DISKNAME%,,

[Hybrid.Reg]
HKCU,"Control Panel\Cursors\Schemes","Lumen",0x00020000,"%SystemRoot%\Cursors\Lumen_Cursors\arrow.cur,%SystemRoot%\Cursors\Lumen_Cursors\help.cur,%SystemRoot%\Cursors\Lumen_Cursors\working.ani,%SystemRoot%\Cursors\Lumen_Cursors\busy.ani,%SystemRoot%\Cursors\Lumen_Cursors\precision.cur,%SystemRoot%\Cursors\Lumen_Cursors\beam.cur,%SystemRoot%\Cursors\Lumen_Cursors\handwriting.cur,%SystemRoot%\Cursors\Lumen_Cursors\unavailable.cur,%SystemRoot%\Cursors\Lumen_Cursors\vert.cur,%SystemRoot%\Cursors\Lumen_Cursors\horz.cur,%SystemRoot%\Cursors\Lumen_Cursors\dgn1.cur,%SystemRoot%\Cursors\Lumen_Cursors\dgn2.cur,%SystemRoot%\Cursors\Lumen_Cursors\move.cur,%SystemRoot%\Cursors\Lumen_Cursors\alternate.cur,%SystemRoot%\Cursors\Lumen_Cursors\link.cur,%SystemRoot%\Cursors\Lumen_Cursors\person.cur,%SystemRoot%\Cursors\Lumen_Cursors\pin.cur"

[Strings]
